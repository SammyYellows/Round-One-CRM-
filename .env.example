# Copy to .env.local and fill in. Never commit .env.local.
# Values are in Supabase: Project Settings → API Keys (use round1-dev locally).

# Safe in the browser: row-level security blocks everything for this key.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Server only. Bypasses row-level security: never use it in a "use client" file.
SUPABASE_SECRET_KEY=sb_secret_...

# Only needed to run `npm run db:migrate` (Supabase → Account → Access Tokens).
# SUPABASE_ACCESS_TOKEN=sbp_...
# SUPABASE_PROJECT_REF=your-project-ref

# Protects /api/cron (runs automation steps that are due). Any long random string;
# a scheduler calls it with "Authorization: Bearer <CRON_SECRET>".
# CRON_SECRET=

# Automation emails (Resend). Without RESEND_API_KEY they're printed to the
# server log instead of sent.
# RESEND_API_KEY=re_...
# EMAIL_FROM=Round One <bookings@round1boxfit.co.uk>
# STAFF_EMAIL=info@round1boxfit.co.uk
# APP_URL=https://round-one-crm.vercel.app

# WhatsApp (Meta Cloud API). Without WHATSAPP_TOKEN and WHATSAPP_PHONE_NUMBER_ID
# messages are recorded in the CRM and printed to the server log, not sent.
# WHATSAPP_TOKEN=            permanent token for the RoundOnecrm system user
# WHATSAPP_PHONE_NUMBER_ID=  the number messages come from
# WHATSAPP_BUSINESS_ACCOUNT_ID=  its WhatsApp account (for templates)
# WHATSAPP_APP_SECRET=       checks that webhook calls really come from Meta
# WHATSAPP_VERIFY_TOKEN=     any long random string; also typed into Meta's webhook setup
# META_APP_ID=               the Round One CRM app, for uploading template videos

# TeamUp (the membership system). Without these the Members screen is empty and
# the nightly sync does nothing. The token is a machine-to-machine token made in
# TeamUp: Settings → Integrations → API Integration (docs/teamup-members.md).
# TEAMUP_M2M_TOKEN=
# TEAMUP_PROVIDER_ID=10418134
# TEAMUP_WEBHOOK_SECRET=   any long random string; part of the webhook address given to TeamUp

# Email enquiries (docs/email-enquiries.md). Resend receives a copy of mail to
# info@ and calls /api/webhooks/resend; Claude drafts a reply for staff to
# check. Without ANTHROPIC_API_KEY emails still arrive, with no draft.
# RESEND_WEBHOOK_SECRET=   the webhook's signing secret from Resend (whsec_...)
# ANTHROPIC_API_KEY=       from console.anthropic.com
# ANTHROPIC_MODEL=claude-opus-5-5
# ENQUIRIES_FROM=Round One <info@round1boxfit.co.uk>   replies go out as this

# Mailouts (docs/mailouts.md). Resend's free plan allows 100 emails a day in
# total, so mailouts are held to this many a day; set 0 after upgrading.
# MAILOUT_DAILY_LIMIT=80
