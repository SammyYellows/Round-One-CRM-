# Copy to .env.local and fill in. Never commit .env.local.
# Values are in Supabase: Project Settings → API Keys (use round1-dev locally).

# Safe in the browser: row-level security blocks everything for this key.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Server only. Bypasses row-level security: never use it in a "use client" file.
SUPABASE_SECRET_KEY=sb_secret_...

# Only needed to run `npm run db:migrate` (Supabase → Account → Access Tokens).
# SUPABASE_ACCESS_TOKEN=sbp_...
# SUPABASE_PROJECT_REF=your-project-ref

# Protects /api/cron (runs automation steps that are due). Any long random string;
# a scheduler calls it with "Authorization: Bearer <CRON_SECRET>".
# CRON_SECRET=

# Automation emails (Resend). Without RESEND_API_KEY they're printed to the
# server log instead of sent.
# RESEND_API_KEY=re_...
# EMAIL_FROM=Round One <bookings@round1boxfit.co.uk>
# STAFF_EMAIL=info@round1boxfit.co.uk
# APP_URL=https://round-one-crm.vercel.app
