# Public URL of the CRM (used in booking links sent to leads)
APP_URL=https://crm.round1fitness.co.uk

# Staff login
ADMIN_PASSWORD=change-me
SESSION_SECRET=a-long-random-string

# Where the SQLite database lives (defaults to ./data/crm.db)
# DATABASE_PATH=/var/lib/round1/crm.db

# Optional: protect GET /api/cron?key=... if you use an external scheduler
# CRON_SECRET=
# Set to 1 to stop the built-in once-a-minute automation ticker
# DISABLE_TICKER=1

# --- WhatsApp Business (Meta Cloud API) — leave blank for dry-run mode ---
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=pick-any-string
WHATSAPP_APP_SECRET=
WHATSAPP_TEMPLATE_LANGUAGE=en_GB

# --- SMS fallback (Twilio) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# --- Email (Resend) ---
RESEND_API_KEY=
EMAIL_FROM="Round 1 Fitness <hello@round1fitness.co.uk>"
# Team notifications ("Internal Notification" steps) go here
STAFF_EMAIL=
